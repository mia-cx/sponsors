{
  "name": "sponsors",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "check": "tsc --noEmit && vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test test/*.test.ts",
    "test:release": "node --test .github/scripts/*.test.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.19.2",
    "ditherette": "0.1.0-rc.0",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "4.151.3"
  }
}
